# e2e/phone/phone.env: this project's names for the phone scripts. Commit it; it holds no
# secrets. Machine-specific values (the team id, a fixed UDID) can live in your shell instead.
APP_BUNDLE_ID=com.example.myapp        # ios.bundleIdentifier in app.config
# APP_ANDROID_PACKAGE=com.example.myapp # android.package, when it differs
APP_NAME=MyApp                         # the Xcode product name: ios/<APP_NAME>/, the process name
APP_SCHEME=myapp                       # deep links: phone.sh link <path>
MOBILE_DIR=apps/mobile                 # the Expo app, from the repo root
# PHONE_TEAM_ID=XXXXXXXXXX             # Apple team id, for signing the runner (or export it)
# PHONE_UDID=                          # only when more than one iPhone is connected
# ANDROID_SERIAL=                      # only when more than one Android device is connected

# A local test server the phone reaches over Wi-Fi (leave out when the app has none):
# API_PORT=8811
# API_PATH=/v1
# API_URL_VAR=EXPO_PUBLIC_API_URL      # the env var the app reads its API address from
# HEALTH_PATH=/health
